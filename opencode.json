{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "read": {
      "**/*": "allow",
      "**/.env*": "deny"
    },
    "edit": {
      "**/*": "allow"
    },
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "npm test*": "allow",
      "*sudo*": "ask",
      "*systemctl*": "ask",
      "rm -rf*": "ask",
      "*": "ask"
    }
  }
}
